{
  "name": "@yisu/shared",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "pnpm run build",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\""
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "@nestjs/mapped-types": "*",
    "zod": "^4.3.6",
    "enum-plus": "^3.1.8"
  },
  "devDependencies": {
    "@yisu/eslint-config": "workspace:*",
    "@yisu/typescript-config": "workspace:*",
    "tsup": "^8.5.1"
  }
}

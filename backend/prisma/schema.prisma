generator client {
  provider = "prisma-client-js"
  output   = "../prisma-generated"
}

datasource db {
  provider = "postgresql"
}

// ===== 用户相关枚举 =====

enum Realm {
  MOBILE
  MERCHANT
  ADMIN
}

// ===== 酒店相关枚举 =====

enum ReviewStatus {
  DRAFT // 待发布
  PENDING // 待审核|审核中
  APPROVED // 已发布|已通过
  REJECTED // 待更改|已拒绝
  DEPRECATED // 已废弃（软删除）
}

enum RejectReasonType {
  INFO_INCOMPLETE // 信息不完整
  INFO_INACCURATE // 信息不准确
  IMAGE_QUALITY // 图片质量问题
  PRICE_ABNORMAL // 价格异常
  DUPLICATE // 重复酒店
  POLICY_VIOLATION // 政策违反
  OTHER // 其他
}

enum PriceMode {
  PER_NIGHT // 按夜晚计价
  PER_HOUR // 按小时计价
}

// ===== 用户模型 =====

model User {
  id        Int      @id @default(autoincrement())
  realm     Realm
  email     String
  username  String
  password  String   @map("password")
  gender    Int      @default(0) // 0 unknown, 1 female, 2 male
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mobileProfile   MobileProfile?
  merchantProfile MerchantProfile?
  adminProfile    AdminProfile?

  // 注册：同 realm 下邮箱只能有一个账号
  @@unique([realm, email], name: "uniq_realm_email")
  // 登录：同 realm 下用户名只能有一个账号（不同 realm 允许同名）
  @@unique([realm, username], name: "uniq_realm_username")
  @@index([email], name: "idx_email")
  @@index([realm, username], name: "idx_realm_username")
  @@map("users")
}

model MobileProfile {
  userId Int  @id @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mobile_profiles")
}

model MerchantProfile {
  userId Int     @id @map("user_id")
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotels Hotel[]

  @@map("merchant_profiles")
}

model AdminProfile {
  userId Int  @id @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  reviewRecords ReviewRecord[] // 管理员审核记录
  @@map("admin_profiles")
}

// ===== 酒店模型 =====

model Hotel {
  id              Int     @id @default(autoincrement())
  hotelNickname   String  @map("hotel_nickname") // 酒店昵称（方便商户区分管理不同酒店）
  isHomeAdEnabled Boolean @default(false) @map("is_home_ad_enabled") // 是否开启首页广告推送

  // 已发布版本
  publishedInfoId Int?       @unique @map("published_info_id")
  publishedInfo   HotelInfo? @relation("publishedInfo", fields: [publishedInfoId], references: [id])

  // 商户归属
  merchantId Int             @map("merchant_id")
  merchant   MerchantProfile @relation(fields: [merchantId], references: [userId])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 所有酒店信息
  infos   HotelInfo[]    @relation("hotelInfos")
  // 被审核记录
  reviews ReviewRecord[]

  // 软删除
  isDeleted Boolean @default(false) @map("is_deleted")

  @@index([merchantId], name: "idx_hotels_merchant_id")
  @@map("hotels")
}

// 酒店信息
model HotelInfo {
  id      Int   @id @default(autoincrement())
  hotelId Int   @map("hotel_id")
  hotel   Hotel @relation("hotelInfos", fields: [hotelId], references: [id], onDelete: Cascade)

  // ===== 酒店基本信息 =====
  infoNickname String  @map("info_nickname") // 信息昵称（仅商家可见）
  name        String // 酒店名称
  enName      String? @map("en_name") // 酒店英文名称
  starLevel   Int     @map("star_level") // 酒店星级
  phone       String? // 酒店热线电话
  description String? @db.Text // 酒店简介

  // 地址信息
  province     String?
  city         String?
  district     String?
  address      String
  // PostGIS用
  locationGeog Unsupported("geography(Point,4326)")? @map("location_geog")

  // 开业时间
  openedAt DateTime? @map("opened_at")

  // 审核状态
  reviewStatus ReviewStatus @default(DRAFT) @map("review_status")

  // 提交人（商户 userId）
  createdBy Int      @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 版本信息的关联数据
  images    HotelImage[] // 详情页顶部轮播图
  roomTypes RoomType[] // 房型列表
  tags      HotelTagRelation[] // 酒店标签
  reviewRecords ReviewRecord[]
  hotels    Hotel[]            @relation("publishedInfo") // 其实这里只可能有0或一个

  homeAdImage String? @map("home_ad_image") // 首页广告图

  @@index([hotelId], name: "idx_hotel_info_hotel_id")
  @@index([reviewStatus], name: "idx_hotel_info_review_status")
  @@map("hotel_infos")
}

model RoomType {
  id     Int       @id @default(autoincrement())
  infoId Int       @map("info_id")
  info   HotelInfo @relation(fields: [infoId], references: [id], onDelete: Cascade)

  count     Int       @map("count") // 房型总数量
  name      String // 钟点房/单人间/双人间/大床房/家庭房/套房/其他
  price     Float // 价格
  priceMode PriceMode @default(PER_NIGHT) @map("price_mode")
  bedType   String?   @map("bed_type") // 床型,例如：1.8m *2.0 m
  maxGuests Int       @map("max_guests") // 最大入住人数
  area      Float? // 面积
  imageUrl  String?   @map("image_url") // 参考图片
  sortOrder Int       @map("sort_order") // 排序用

  @@index([infoId], name: "idx_room_type_info_id")
  @@index([price], name: "idx_room_type_price")
  @@map("room_types")
}

// 详情页轮播图
model HotelImage {
  id     Int       @id @default(autoincrement())
  infoId Int       @map("info_id")
  info   HotelInfo @relation(fields: [infoId], references: [id], onDelete: Cascade)

  url       String
  sortOrder Int     @map("sort_order")
  caption   String? // 图片说明文字

  @@index([infoId], name: "idx_hotel_image_info_id")
  @@map("hotel_images")
}

// 全局标签字典
model HotelTag {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  category String // facility / feature / scene 等分类
  icon     String?

  relations HotelTagRelation[]

  @@index([category], name: "idx_hotel_tag_category")
  @@map("hotel_tags")
}

// 版本-标签关联（多对多）
model HotelTagRelation {
  id     Int       @id @default(autoincrement())
  infoId Int       @map("info_id")
  info   HotelInfo @relation(fields: [infoId], references: [id], onDelete: Cascade)
  tagId  Int       @map("tag_id")
  tag    HotelTag  @relation(fields: [tagId], references: [id])

  @@unique([infoId, tagId], name: "uniq_info_tag")
  @@map("hotel_tag_relations")
}

// 审核记录
model ReviewRecord {
  id      Int   @id @default(autoincrement())
  hotelId Int   @map("hotel_id")
  hotel   Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  infoId       Int               @map("info_id")
  info         HotelInfo         @relation(fields: [infoId], references: [id], onDelete: Cascade)
  reviewerId   Int               @map("reviewer_id")
  reviewer     AdminProfile      @relation(fields: [reviewerId], references: [userId])
  action       ReviewStatus
  rejectReason RejectReasonType? @map("reject_reason") // 需要后端约束，只有`其他`时，rejectDetail才可选
  rejectDetail String?           @map("reject_detail") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([hotelId], name: "idx_review_record_hotel_id")
  @@index([infoId], name: "idx_review_record_info_id")
  @@index([reviewerId], name: "idx_review_record_reviewer_id")
  @@map("review_records")
}
